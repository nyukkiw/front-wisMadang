# Alamat backend Laravel. Biarkan seperti ini kalau backend dijalankan dengan "php artisan serve" (default).
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# Client Key dari akun Midtrans Sandbox kamu sendiri (dashboard.sandbox.midtrans.com > Settings > Access Keys).
# Harus SAMA PERSIS dengan MIDTRANS_CLIENT_KEY di back-site/.env.
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=
